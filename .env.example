# Ambiente de execução da aplicação (Ex: development, production, test)
NODE_ENV=development
# Porta em que o servidor Express irá rodar no seu ambiente local
PORT=3000


# Chave secreta md5 ou texto aleatório para criptografia e validação dos tokens JWT (AUTENTICAÇÃO JWT)
APP_SECRET=sua_chave_secreta_jwt_aqui


# O dialeto do banco de dados que o Sequelize vai usar (Ex: postgres, mysql, sqlite)
DB_DIALECT=postgres
# Endereço ou IP do servidor do banco de dados PostgreSQL (Ex: localhost ou 127.0.0.1)
DB_HOST=localhost
# Seu nome de usuário do banco de dados PostgreSQL (Ex: postgres)
DB_USER=postgres
# A senha de acesso do seu usuário do PostgreSQL
DB_PASS=sua_senha_do_postgre
# O nome do banco de dados criado para este projeto no seu PostgreSQL
DB_NAME=nome_do_banco_criado_no_pgadmin


# Endereço de conexão com o servidor/container do Redis (BEE-QUEUE/Filas) (Ex: 127.0.0.1 ou localhost)
REDIS_HOST=localhost
# Porta padrão de comunicação com o Redis (Normalmente é a 6379)
REDIS_PORT=6379


# O endereço do servidor SMTP para envio de e-mails em desenvolvimento com Nodemailer/Mailtrap (Ex: sandbox.smtp.mailtrap.io)
MAIL_HOST=sandbox.smtp.mailtrap.io
# A porta utilizada pelo servidor SMTP do Mailtrap (Ex: 2525, 465 ou 587)
MAIL_PORT=2525
# O seu token/usuário de autenticação fornecido pelo Mailtrap na sua Inbox
MAIL_USER=seu_usuario_do_mailtrap
# A sua senha de autenticação fornecida pelo Mailtrap na sua Inbox
MAIL_PASS=sua_senha_do_mailtrap
